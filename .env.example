# Уровень логирования: debug, info, warn или error
LOG_LEVEL=info

# Секрет Telegram-бота, полученный через BotFather
TELEGRAM_BOT_TOKEN=your_secret_here

# Таймаут первичной проверки подключения к Telegram
TELEGRAM_INIT_TIMEOUT=30s

# Прокси для доступа к Telegram при необходимости
# HTTPS_PROXY=https://username:password@proxy.example.com:443

# Строка подключения к PostgreSQL
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=redbutton port=5432 sslmode=disable

# Настройки PostgreSQL для Docker Compose
POSTGRES_USER=redbutton
POSTGRES_PASSWORD=change_me
POSTGRES_DB=redbutton

# Время работы бота в UTC+5
TASK_START_DATE=2026-09-01T00:00:00
TASK_END_DATE=2026-09-07T00:00:00

# Интервал резервной проверки новых тасков
NOTIFICATION_INTERVAL=15s

# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=123456789,987654321

# Директория с YAML-файлами тасков
TASKS_DIRECTORY=tasks

# Время жизни задания
TASK_EXPIRE=24h
